# --- LLM ---
ANTHROPIC_API_KEY=            # required for AI answers (console.anthropic.com)
MODEL_NAME=claude-sonnet-5-5    # any Claude model id

# --- App auth (shared login) ---
# The app REFUSES TO START while these still contain the placeholder values.
CHATBOT_USERNAME=admin
CHATBOT_PASSWORD=change-me
# Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# --- Cookies / TLS ---
# Session cookies are marked Secure (HTTPS-only) by default. Set to false ONLY
# for local development over plain http:// (never in production).
# COOKIE_SECURE=false

# --- MHCO.org scraper credentials (members-only content) ---
MHCO_USERNAME=
MHCO_PASSWORD=

# --- Optional overrides ---
# DATA_DIR=./data
# MHCO_BASE_URL=https://mhco.org
